# Environment Variables — Valorant Store Bot
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า (สำหรับ local test)
# สำหรับ Railway ให้ใส่ใน Project → Variables แทน

# ── Riot Account ──────────────────────────────────────
RIOT_USERNAME=your_riot_email@example.com
RIOT_PASSWORD=your_password_here

# ── Session Cookie (รับจาก setup.py) ─────────────────
RIOT_SSID=your_ssid_cookie_here

# ── Region ───────────────────────────────────────────
# ap = Asia Pacific (TH, SG, JP, KR, ...)
# na = North America
# eu = Europe
# br = Brazil
# latam = Latin America
REGION=ap

# ── Discord Webhook ───────────────────────────────────
# สร้างได้ที่: Discord Server → Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
